# ============================================================
# Картина Души — Environment Variables
# Скопируй этот файл в .env и заполни значения
# В Vercel добавь через: Settings → Environment Variables
# ============================================================

# --- Telegram ---
# 1. Открой @BotFather в Telegram, создай бота, скопируй токен
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi

# 2. Напиши боту /start, затем открой:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Найди "chat":{"id": XXXXX} — это твой CHAT_ID
#    Или добавь бота в группу и сделай то же самое
TELEGRAM_CHAT_ID=123456789

# --- Email (SMTP) ---
# Gmail: используй App Password (не основной пароль!)
# Инструкция: Google Account → Security → 2-Step → App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_TO=your@gmail.com
